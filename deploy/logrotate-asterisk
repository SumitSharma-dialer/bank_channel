# -> /etc/logrotate.d/asterisk (replaces the Debian package's weekly / 4 weeks)
# Asterisk logs (full = what the CLI shows, messages.log, queue_log): one file per day, kept 5 days, gzip.
/var/log/asterisk/*.log /var/log/asterisk/*_log /var/log/asterisk/full {
        daily
        rotate 5
        maxage 5
        missingok
        notifempty
        compress
        delaycompress
        sharedscripts
        postrotate
                /usr/sbin/asterisk -rx 'logger reload' > /dev/null 2> /dev/null || true
        endscript
}
